# Server
PORT=5001
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.4g7d8mf.mongodb.net/portfolio?retryWrites=true&w=majority

# Security
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials
ADMIN_EMAIL=admin@para.studio
ADMIN_PASSWORD=SetAStrongPasswordHere123!

# Frontend URL (comma-separated if multiple, e.g. https://portfolio.com,https://portfolio.vercel.app)
CLIENT_ORIGIN=https://your-frontend-domain.com

# Media Storage (Cloudinary - Recommended for production persistence)
# If omitted, uploads will be stored on local disk (which is ephemeral on free Render/Railway dynos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
